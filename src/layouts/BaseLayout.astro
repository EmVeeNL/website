---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MainContent from "../components/MainContent.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { Font } from "astro:assets";
import "../styles/global.css";

type HreflangAlternate = {
	lang: string;
	href: string;
};

type Props = {
	title?: string;
	description?: string;
	lang?: string;
	canonical?: string;
	noindex?: boolean;
	alternates?: HreflangAlternate[];
	bodyClass?: string;
	mainClass?: string;
	/** Absolute URL. Pages without a real image simply omit og:image/twitter:image. */
	ogImage?: string;
};

const {
	title = "EMVEE",
	description = "EMVEE",
	lang = "nl",
	canonical,
	noindex = false,
	alternates,
	bodyClass,
	mainClass,
	ogImage,
} = Astro.props as Props;

const ogLocale = lang === "en" ? "en_US" : "nl_NL";

// Organization/WebSite facts kept deliberately minimal — only what's already
// public elsewhere on the site (see src/content/components/*/contact/details.md).
// No phone/email/sameAs here: the real ones aren't set yet (see AGENTS.md).
const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: "EMVEE",
	url: Astro.site?.toString(),
	logo: new URL("/favicon.svg", Astro.site).toString(),
	description: "EMVEE ontwerpt en bouwt websites, webapplicaties en e-commerce met aandacht voor duidelijkheid, kwaliteit en persoonlijk contact.",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Mook",
		addressCountry: "NL",
	},
	areaServed: {
		"@type": "Country",
		name: "Netherlands",
	},
};

const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "EMVEE",
	url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				const storageKey = "emvee-theme";
				const storedTheme = localStorage.getItem(storageKey);
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const theme = storedTheme === "light" || storedTheme === "dark"
					? storedTheme
					: prefersDark
						? "dark"
						: "light";

				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		{alternates?.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />

		<meta property="og:site_name" content="EMVEE" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		{!noindex && (
			<>
				<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
				<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
			</>
		)}
		<Font
			cssVariable="--font-chocopie"
			preload={[
				{ weight: 400, style: "normal" },
				{ weight: 700, style: "normal" },
				{ weight: 900, style: "normal" },
			]}
		/>
		<Font cssVariable="--font-geist" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-geist-mono" preload={false} />
		<Font cssVariable="--font-lora" preload={false} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main-content">Naar inhoud</a>
		<div class="flex min-h-screen flex-col bg-background text-foreground">
			<Header />
			<MainContent class={mainClass}>
				<slot />
			</MainContent>
			<Footer />
		</div>
		<ScrollReveal />
	</body>
</html>
