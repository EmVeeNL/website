---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina niet gevonden — EMVEE" description="Deze pagina bestaat niet of is verplaatst." lang="nl">
	<section class="flex min-h-[60svh] flex-col items-start justify-center px-6 py-20 md:px-12 lg:px-20">
		<p class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-brand-secondary dark:text-accent">404</p>
		<h1 class="max-w-[16ch] text-[clamp(2rem,6vw,3rem)] font-bold leading-tight text-foreground">
			Deze pagina bestaat niet
		</h1>
		<p class="mt-5 max-w-[38rem] text-lg leading-relaxed text-foreground-muted">
			De pagina die je zoekt is verplaatst of bestaat niet (meer). Ga terug naar de homepage om verder te kijken.
		</p>
		<a
			href="/"
			class="cta-gradient mt-8 inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3.5 text-sm font-bold uppercase tracking-[0.04em] text-accent-foreground no-underline shadow-lg transition-transform duration-150 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-focus)]"
		>
			Naar de homepage
		</a>
	</section>
</BaseLayout>
