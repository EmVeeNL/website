---
type Action = {
	label: string;
	href: string;
};

type ContactFormContent = {
	componentId?: string;
	heading?: string;
	fields: {
		name: string;
		organisation: string;
		email: string;
		phone: string;
		subject: string;
		message: string;
	};
	optionalLabel: string;
	consent: {
		before?: string;
		link: Action;
		after?: string;
	};
	submitLabel: string;
	successMessage: string;
	errorMessage: string;
};

type Props = {
	form: ContactFormContent;
};

const { form } = Astro.props as Props;

const inputClass =
	"mt-2 block w-full rounded-lg border border-border-subtle bg-background px-4 py-3 text-[0.9375rem] text-foreground placeholder:text-foreground-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]";
const labelClass = "text-[0.8125rem] font-bold text-foreground";
const optionalTagClass = "ml-1 font-normal normal-case text-foreground-subtle";
---

<section id={form.componentId} data-reveal class="px-6 py-10 md:px-12 lg:px-20 lg:py-16">
	<div class="mx-auto max-w-2xl">
		{form.heading && (
			<h2 class="max-w-[24ch] text-[clamp(1.5rem,4vw,2.25rem)] font-bold leading-[1.14] text-foreground">
				{form.heading}
			</h2>
		)}

		<form
			class="mt-8 grid gap-5"
			method="post"
			action="/api/contact"
			data-contact-form
			data-success-message={form.successMessage}
			data-error-message={form.errorMessage}
		>
			<div aria-live="polite" class="hidden rounded-lg px-4 py-3 text-[0.9375rem]" data-form-status></div>

			<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

			<div>
				<label class={labelClass} for="contact-name">{form.fields.name}</label>
				<input class={inputClass} id="contact-name" name="name" type="text" autocomplete="name" required />
			</div>

			<div>
				<label class={labelClass} for="contact-organisation">
					{form.fields.organisation}
					<span class={optionalTagClass}>({form.optionalLabel})</span>
				</label>
				<input class={inputClass} id="contact-organisation" name="organisation" type="text" autocomplete="organization" />
			</div>

			<div>
				<label class={labelClass} for="contact-email">{form.fields.email}</label>
				<input class={inputClass} id="contact-email" name="email" type="email" autocomplete="email" required />
			</div>

			<div>
				<label class={labelClass} for="contact-phone">
					{form.fields.phone}
					<span class={optionalTagClass}>({form.optionalLabel})</span>
				</label>
				<input class={inputClass} id="contact-phone" name="phone" type="tel" autocomplete="tel" />
			</div>

			<div>
				<label class={labelClass} for="contact-subject">{form.fields.subject}</label>
				<input class={inputClass} id="contact-subject" name="subject" type="text" required />
			</div>

			<div>
				<label class={labelClass} for="contact-message">{form.fields.message}</label>
				<textarea class={`${inputClass} min-h-32 resize-y`} id="contact-message" name="message" rows="6" required></textarea>
			</div>

			<label class="flex items-start gap-3 text-[0.875rem] leading-6 text-foreground-muted">
				<input
					type="checkbox"
					name="consent"
					required
					class="mt-1 size-4 shrink-0 rounded border-border-strong text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
				/>
				<span>
					{form.consent.before}{" "}
					<a class="font-bold text-accent underline decoration-[0.08em] underline-offset-[0.2em] hover:text-accent-hover" href={form.consent.link.href}>
						{form.consent.link.label}
					</a>{form.consent.after}
				</span>
			</label>

			<button
				type="submit"
				class="cta-gradient mt-2 inline-flex min-h-12 w-fit items-center justify-center rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.04em] text-accent-foreground no-underline shadow-lg transition-transform duration-150 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-focus)]"
			>
				{form.submitLabel}
			</button>
		</form>
	</div>
</section>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

	for (const form of forms) {
		const status = form.querySelector<HTMLElement>("[data-form-status]");
		const successMessage = form.dataset.successMessage ?? "";
		const errorMessage = form.dataset.errorMessage ?? "";

		function showStatus(message: string, tone: "success" | "error") {
			if (!status) return;

			status.textContent = message;
			status.classList.remove("hidden", "bg-accent-subtle", "text-accent-hover");
			status.classList.toggle("bg-accent-subtle", tone === "success");
			status.classList.toggle("text-accent-hover", tone === "success");
			status.classList.toggle("border", tone === "error");
			status.classList.toggle("border-border-strong", tone === "error");
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const formData = new FormData(form);
			const payload = {
				name: formData.get("name"),
				organisation: formData.get("organisation"),
				email: formData.get("email"),
				phone: formData.get("phone"),
				subject: formData.get("subject"),
				message: formData.get("message"),
				consent: formData.get("consent") === "on",
				website: formData.get("website"),
				lang: document.documentElement.lang === "en" ? "en" : "nl",
			};

			submitButton?.setAttribute("disabled", "true");

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: { "content-type": "application/json", accept: "application/json" },
					body: JSON.stringify(payload),
				});

				if (!response.ok) throw new Error("request_failed");

				showStatus(successMessage, "success");
				form.reset();
			} catch {
				showStatus(errorMessage, "error");
			} finally {
				submitButton?.removeAttribute("disabled");
			}
		});
	}
</script>
