---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
	article: CollectionEntry<"knowledge">;
	href: string;
};

const { article, href } = Astro.props as Props;
const { title, excerpt, publishedAt, cover, tags, language } = article.data;

const formattedDate = new Intl.DateTimeFormat(language === "en" ? "en-GB" : "nl-NL", {
	year: "numeric",
	month: "long",
	day: "numeric",
}).format(publishedAt);
---

<a
	href={href}
	class="group flex flex-col overflow-hidden rounded-2xl border border-border-subtle bg-background-subtle transition-colors duration-150 hover:border-border-strong"
>
	{cover && (
		<Image
			src={cover}
			alt=""
			width={640}
			height={360}
			class="aspect-video w-full object-cover"
		/>
	)}

	<div class="flex flex-1 flex-col p-6">
		<time datetime={publishedAt.toISOString()} class="text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-foreground-subtle">
			{formattedDate}
		</time>

		<h3 class="mt-2 text-lg font-bold leading-[1.22] text-foreground group-hover:text-accent">{title}</h3>

		<p class="mt-3 text-[0.9375rem] leading-6 text-foreground-muted">{excerpt}</p>

		{tags?.length ? (
			<ul class="mt-4 flex flex-wrap gap-2">
				{tags.map((tag) => (
					<li class="rounded-full bg-accent-subtle px-3 py-1 text-[0.75rem] font-bold uppercase tracking-[0.04em] text-accent-hover dark:text-accent">
						{tag}
					</li>
				))}
			</ul>
		) : null}
	</div>
</a>
