---
type Props = {
	name: "arrow-right-linear" | "hamburger-menu-linear" | "close-circle-linear" | "moon-linear" | "sun-2-linear";
	size?: number | string;
	class?: string;
	label?: string;
	decorative?: boolean;
};

const {
	name,
	size = 24,
	class: className,
	label,
	decorative = !label,
} = Astro.props as Props;

const icons: Record<Props["name"], string> = {
	"arrow-right-linear": '<path d="M4 12h15m0 0-6-6m6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>',
	"hamburger-menu-linear": '<path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>',
	"close-circle-linear": '<path d="M9 9l6 6m0-6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" fill="none" stroke="currentColor" stroke-width="1.8"/>',
	"moon-linear": '<path d="M20.4 14.5A8.5 8.5 0 0 1 9.5 3.6 8.5 8.5 0 1 0 20.4 14.5Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>',
	"sun-2-linear": '<path d="M12 16.2a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.8v2M12 19.2v2M4.4 4.4l1.4 1.4M18.2 18.2l1.4 1.4M2.8 12h2M19.2 12h2M4.4 19.6l1.4-1.4M18.2 5.8l1.4-1.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>',
};

const renderedSize = typeof size === "number" ? String(size) : size;
---

<svg
	class={className}
	xmlns="http://www.w3.org/2000/svg"
	width={renderedSize}
	height={renderedSize}
	viewBox="0 0 24 24"
	aria-hidden={decorative ? "true" : undefined}
	role={decorative ? undefined : "img"}
	aria-label={decorative ? undefined : label}
	focusable="false"
	set:html={icons[name]}
/>
