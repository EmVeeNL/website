---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

type StepListAction = {
	label: string;
	href: string;
};

type StepListStep = {
	title: string;
	description?: string;
	list?: string[];
};

type StepListContent = {
	componentId?: string;
	eyebrow?: string;
	heading?: string;
	intro?: string;
	columns?: "2" | "3" | "4";
	steps?: StepListStep[];
	action?: StepListAction;
	image?: ImageMetadata;
};

type Props = {
	steps: StepListContent;
};

const { steps } = Astro.props as Props;
const columnsClass = {
	"2": "sm:grid-cols-2",
	"3": "sm:grid-cols-2 lg:grid-cols-3",
	"4": "sm:grid-cols-2 lg:grid-cols-4",
}[steps.columns ?? "3"];
---

<section id={steps.componentId} data-reveal class="px-6 py-10 md:px-12 lg:px-20 lg:py-16">
	<div class="mx-auto max-w-6xl">
		{steps.eyebrow && (
			<p class="mb-4 inline-flex items-center gap-3 whitespace-nowrap text-[0.6875rem] font-bold uppercase leading-5 tracking-[0.14em] text-brand-secondary sm:text-sm sm:tracking-[0.2em] dark:text-accent">
				<span aria-hidden="true" class="h-px w-6 shrink-0 bg-linear-to-r from-accent to-transparent sm:w-8"></span>
				<span>{steps.eyebrow}</span>
			</p>
		)}

		{steps.heading && (
			<h2 class="max-w-[24ch] text-[clamp(1.5rem,4vw,2.25rem)] font-bold leading-[1.14] text-foreground">
				{steps.heading}
			</h2>
		)}

		{steps.intro && <p class="mt-4 max-w-[60ch] text-[1.0625rem] leading-[1.75] text-foreground-muted sm:text-lg">{steps.intro}</p>}

		{steps.image && (
			<Image
				src={steps.image}
				alt=""
				width={1280}
				height={720}
				class="mt-8 aspect-video w-full rounded-2xl object-cover"
			/>
		)}

		{steps.steps?.length ? (
			<ol class:list={["mt-8 grid gap-6", columnsClass]}>
				{steps.steps.map((step, index) => (
					<li class="rounded-2xl border border-border-subtle bg-background-subtle p-6">
						<span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent-subtle text-sm font-bold text-accent" aria-hidden="true">
							{index + 1}
						</span>
						<h3 class="mt-4 text-lg font-bold leading-[1.22] text-foreground">{step.title}</h3>

						{step.description && <p class="mt-3 text-[0.9375rem] leading-6 text-foreground-muted">{step.description}</p>}

						{step.list?.length ? (
							<ul class="mt-4 space-y-2 text-[0.875rem] leading-6 text-foreground-muted">
								{step.list.map((point) => (
									<li class="flex items-start gap-2.5">
										<span aria-hidden="true" class="mt-2 grid size-4 shrink-0 place-items-center rounded-full bg-brand-secondary/15">
											<span class="size-1 rounded-full bg-accent"></span>
										</span>
										<span>{point}</span>
									</li>
								))}
							</ul>
						) : null}
					</li>
				))}
			</ol>
		) : null}

		{steps.action && (
			<div class="mt-8">
				<a
					href={steps.action.href}
					class="group inline-flex min-h-11 items-center gap-2 px-2 py-2 text-base font-bold text-foreground-muted no-underline transition-colors duration-150 hover:text-brand-secondary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-focus)]"
				>
					<span>{steps.action.label}</span>
					<Icon name="arrow-right-linear" size={20} class="transition-transform duration-150 group-hover:translate-x-1" />
				</a>
			</div>
		)}
	</div>
</section>
